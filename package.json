{
  "name": "sweet-workbench",
  "version": "1.0.0",
  "description": "甜蜜工作台 PWA + 视频做法分析后端（Node 一体化服务）",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file=.env server.js",
    "prepare:web": "node scripts/prepare-web.js",
    "cap:add": "npx cap add android",
    "cap:sync": "node scripts/prepare-web.js && npx cap sync android"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0"
  }
}
