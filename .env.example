# 复制本文件为 .env 并填入你的值（.env 不会被提交）
# 大模型：默认豆包/火山（Volcengine Ark，OpenAI 兼容）
# 在火山方舟控制台创建推理接入点后，把 API Key 与模型 ID 填到下面

# 你的 Ark API Key（必填，否则自动总结降级为仅提取元数据）
LLM_API_KEY=

# 接口地址（一般无需修改）
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 模型 ID（请在 Ark 控制台确认你开通的模型，例如 doubao-seed-1-6-250615）
LLM_MODEL=doubao-seed-1-6-250615

# 服务端口
PORT=3000
